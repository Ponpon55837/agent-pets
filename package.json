{
  "name": "agent-pets",
  "version": "1.13.1",
  "description": "Desktop pet that shows the status of AI coding agents",
  "author": "Upfloor5",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:safe": "vite --mode gpu-safe",
    "prebuild": "node scripts/stop-agent-pets.mjs",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "prebuild:fast": "node scripts/stop-agent-pets.mjs",
    "build:fast": "vue-tsc --noEmit && vite build && electron-builder --config.compression=store",
    "test:unit": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ && node scripts/lint-main-process.mjs",
    "test:coverage": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test-coverage-include='electron/main/**' --test-coverage-include='electron/diagnostics/**' --test-coverage-include='electron/event-*.ts' --test-coverage-include='electron/local-server-listen.ts' --test-coverage-lines=85 tests/*.test.mts",
    "test:unit:watch": "node --test --watch --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:bundle": "node scripts/check-plugin-panel-tokens-bundle.mjs",
    "bench:lag": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench/event-loop-lag.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:design:strict": "node scripts/check-design-tokens.mjs --strict --raw-colors=fail",
    "bench": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench/phase-18.mjs",
    "preview": "vite preview",
    "electron:dev": "vite --config vite.config.mts",
    "preelectron:build": "node scripts/stop-agent-pets.mjs",
    "electron:build": "vue-tsc --noEmit && vite build && electron-builder"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "koffi": "3.2.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-electron": "^1.2.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "com.agent-pets.app",
    "productName": "Agent Pets",
    "extraMetadata": {
      "homepage": "https://github.com/Ponpon55837/agent-pets",
      "desktopName": "agent-pets.desktop"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "integrations",
        "to": "integrations",
        "filter": [
          "agent-hook.mjs",
          "agent-hook.cmd",
          "presentation-mcp.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        },
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "x64"
        }
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "maintainer": "Agent Pets <https://github.com/Ponpon55837/agent-pets>",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AgentPets-${version}.exe"
    },
    "nsis": {
      "artifactName": "AgentPets-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "appImage": {
      "artifactName": "AgentPets-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "AgentPets-${version}-${arch}.deb"
    },
    "dmg": {
      "artifactName": "AgentPets-${version}-${arch}.dmg"
    }
  }
}
